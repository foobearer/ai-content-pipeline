# ─────────────────────────────────────────────────────────────────────────────
# Multi-Modal AI Content Analysis Pipeline — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Values marked [OPTIONAL] are not required to run the app.
#
#   cp .env.example .env
#
# The app will start with only HuggingFace (no keys needed).
# Add OpenAI or Google keys to unlock those providers.
# ─────────────────────────────────────────────────────────────────────────────


# ── App Settings ──────────────────────────────────────────────────────────────

# Which provider to use by default when the frontend doesn't specify one.
# Options: "openai" | "google" | "huggingface"
DEFAULT_PROVIDER=huggingface

# Max file size accepted for uploads (in megabytes)
MAX_FILE_SIZE_MB=50

# Where to store temporary uploaded files (deleted after analysis)
TEMP_DIR=/tmp/ai_pipeline

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ── OpenAI [OPTIONAL] ─────────────────────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Free tier gives $5 credit on new accounts.
#
OPENAI_API_KEY=

# Model to use for image and text analysis (gpt-4o is cheapest vision model)
OPENAI_VISION_MODEL=gpt-4o

# Model to use for text-only tasks
OPENAI_TEXT_MODEL=gpt-4o-mini

# Whisper model for audio/video transcription
# Options: whisper-1 (only option via API)
OPENAI_WHISPER_MODEL=whisper-1


# ── Google Cloud [OPTIONAL] ───────────────────────────────────────────────────
# Full setup guide: docs/SETUP.md#google-cloud
#
# Path to your downloaded service account JSON key file.
# See: https://cloud.google.com/iam/docs/creating-managing-service-account-keys
GOOGLE_APPLICATION_CREDENTIALS=

# Your Google Cloud project ID (found in Cloud Console)
GOOGLE_CLOUD_PROJECT=

# Region for Speech-to-Text (us-central1 has widest model support)
GOOGLE_CLOUD_REGION=us-central1


# ── HuggingFace [NO KEY NEEDED] ───────────────────────────────────────────────
# Models run locally on your machine — no API key required.
# First run will download models (~2GB total). Subsequent runs use cache.
#
# Where to cache downloaded models (default: ~/.cache/huggingface)
HF_HOME=

# Set to "1" to disable progress bars during model download
TRANSFORMERS_VERBOSITY=info

# HuggingFace API token — only needed if you want to access private models
# Get one free at: https://huggingface.co/settings/tokens
HF_TOKEN=
